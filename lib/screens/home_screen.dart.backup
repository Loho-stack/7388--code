import 'package:flutter/material.dart';
import 'dart:typed_data';
import '../models/ebook.dart';
import '../screens/reader_screen.dart';
import '../screens/settings_screen.dart';
import '../services/database_service.dart';
import '../services/storage_service.dart';
import '../services/thumbnail_service.dart';

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  final DatabaseService _databaseService = DatabaseService.instance;
  final StorageService _storageService = StorageService.instance;
  late Future<List<Ebook>> _ebooksFuture;
  String _searchQuery = '';
  String? _selectedGrade; // null = "All Grades"

  @override
  void initState() {
    super.initState();
    _loadEbooks();
  }

  void _loadEbooks() {
    setState(() {
      _ebooksFuture = _databaseService.getAllEbooks();
    });
  }

  List<Ebook> _filterEbooks(List<Ebook> ebooks) {
    var filtered = ebooks;
    
    // Filter by grade (required - no All Grades option)
    if (_selectedGrade != null) {
      filtered = filtered.where((e) => e.grade == _selectedGrade).toList();
    } else {
      // No grade selected, return empty
      return [];
    }
    
    // Filter by search query
    if (_searchQuery.isNotEmpty) {
      filtered = filtered
          .where((e) =>
              e.title.toLowerCase().contains(_searchQuery.toLowerCase()) ||
              e.author.toLowerCase().contains(_searchQuery.toLowerCase()))
          .toList();
    }
    
    return filtered;
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Row(
          children: [
            GestureDetector(
              onTap: () {
                setState(() {
                  _selectedGrade = null;
                  _searchQuery = '';
                });
              },
              child: Container(
                padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                decoration: BoxDecoration(
                  border: Border.all(color: Color(0xFFe85021), width: 2),
                  borderRadius: BorderRadius.circular(8),
                ),
                child: Row(
                  children: [
                    Icon(Icons.home, color: Color(0xFFe85021), size: 20),
                    const SizedBox(width: 6),
                    Text(
                      'Home',
                      style: TextStyle(
                        color: Color(0xFFe85021),
                        fontWeight: FontWeight.bold,
                        fontSize: 16,
                      ),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(width: 16),
            const Text('Elimu Pepe'),
          ],
        ),
        backgroundColor: const Color(0xFF36a4da),
        elevation: 0,
        actions: [
          PopupMenuButton(
            itemBuilder: (context) => [
              PopupMenuItem(
                onTap: () {
                  Navigator.push(
                    context,
                    MaterialPageRoute(
                      builder: (context) => const SettingsScreen(),
                    ),
                  );
                },
                child: const Text('Settings'),
              ),
            ],
          ),
        ],
      ),
      body: SingleChildScrollView(
        child: Center(
          child: ConstrainedBox(
            constraints: const BoxConstraints(minHeight: 0),
            child: IntrinsicHeight(
              child: Column(
                children: [
                  // SELECT CATEGORY heading
                  Padding(
                    padding: const EdgeInsets.fromLTRB(24, 24, 24, 16),
                    child: Text(
                      'SELECT CATEGORY',
                      style: TextStyle(
                        fontSize: 24,
                        fontWeight: FontWeight.bold,
                        color: Color(0xFFe85021),
                      ),
                    ),
                  ),
                  // Grade category boxes in horizontal line
                  Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 24),
                    child: Row(
                      mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                      children: List.generate(3, (index) {
                        final grade = (index + 1).toString();
                        final isSelected = _selectedGrade == grade;
                        return Expanded(
                          child: GestureDetector(
                            onTap: () {
                              setState(() {
                                _selectedGrade = grade;
                              });
                            },
                            child: Container(
                              margin: const EdgeInsets.symmetric(horizontal: 6),
                              padding: const EdgeInsets.symmetric(vertical: 20),
                              decoration: BoxDecoration(
                                color: isSelected ? Color(0xFFe85021).withOpacity(0.1) : Colors.white,
                                borderRadius: BorderRadius.circular(12),
                                border: Border.all(
                                  color: Color(0xFFe85021),
                                  width: isSelected ? 3 : 2,
                                ),
                                boxShadow: [
                                  BoxShadow(
                                    color: Colors.black.withOpacity(0.1),
                                    blurRadius: 8,
                                    offset: Offset(0, 4),
                                  ),
                                ],
                              ),
                              child: Center(
                                child: Text(
                                  'Grade $grade',
                                  style: TextStyle(
                                    fontSize: 16,
                                    fontWeight: FontWeight.bold,
                                    color: Color(0xFF36a4da),
                                  ),
                                ),
                              ),
                            ),
                          ),
                        );
                      }),
                    ),
                  ),
                  // Kid-friendly illustration - only show if no grade selected
                  if (_selectedGrade == null)
                    Padding(
                      padding: const EdgeInsets.all(20),
                      child: Row(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: 
                          // Left decorative section
                          Expanded(
                            flex: 1,
                            child: Column(
                              children: [
                                Icon(Icons.school, size: 60, color: Color(0xFF36a4da).withOpacity(0.3)),
                                const SizedBox(height: 20),
                                Icon(Icons.auto_stories, size: 50, color: Color(0xFFe85021).withOpacity(0.3)),
                                const SizedBox(height: 20),
                                Icon(Icons.menu_book, size: 55, color: Color(0xFF36a4da).withOpacity(0.3)),
                              ],
                            ),
                          ),
                          // Center welcome section
                          Container(
                            constraints: BoxConstraints(maxWidth: 500),
                            padding: const EdgeInsets.all(20),
                            decoration: BoxDecoration(
                gradient: LinearGradient(
                  begin: Alignment.topLeft,
                  end: Alignment.bottomRight,
                  colors: [
                    Color(0xFF36a4da).withOpacity(0.1),
                    Color(0xFFe85021).withOpacity(0.05),
                  ],
                ),
                borderRadius: BorderRadius.circular(20),
              ),
              child: Column(
                children: [
                  // Standalone Kid illustration
                  Container(
                    height: 180,
                    width: 180,
                    margin: const EdgeInsets.symmetric(vertical: 16),
                    child: Stack(
                      alignment: Alignment.center,
                      children: [
                        // Decorative icons around the image
                        Positioned(
                          left: 0,
                          top: 0,
                          child: Icon(Icons.star, color: Color(0xFFe85021), size: 24),
                        ),
                        Positioned(
                          right: 0,
                          top: 10,
                          child: Icon(Icons.auto_stories, color: Color(0xFF36a4da), size: 28),
                        ),
                        Positioned(
                          left: 10,
                          bottom: 0,
                          child: Icon(Icons.school, color: Color(0xFFe85021), size: 22),
                        ),
                        Positioned(
                          right: 15,
                          bottom: 5,
                          child: Icon(Icons.emoji_objects, color: Color(0xFF36a4da), size: 26),
                        ),
                        // Main character image - will be replaced with actual image
                        Center(
                          child: Image.asset(
                            'assets/images/kid_reading.png',
                            height: 150,
                            width: 150,
                            fit: BoxFit.contain,
                            errorBuilder: (context, error, stackTrace) {
                              // Fallback if image not found
                              return Container(
                                height: 150,
                                width: 150,
                                decoration: BoxDecoration(
                                  shape: BoxShape.circle,
                                  color: Colors.white,
                                  boxShadow: [
                                    BoxShadow(
                                      color: Color(0xFF36a4da).withOpacity(0.3),
                                      blurRadius: 20,
                                      spreadRadius: 5,
                                    ),
                                  ],
                                ),
                                child: Column(
                                  mainAxisAlignment: MainAxisAlignment.center,
                                  children: [
                                    Text('😊', style: TextStyle(fontSize: 40)),
                                    const SizedBox(height: 8),
                                    Icon(Icons.menu_book, size: 40, color: Color(0xFFe85021)),
                                  ],
                                ),
                              );
                            },
                          ),
                        ),
                      ],
                    ),
                  ),
                  const SizedBox(height: 20),
                  Text(
                    'WELCOME TO',
                    style: TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.w600,
                      color: Colors.black87,
                      letterSpacing: 2.0,
                    ),
                  ),
                  const SizedBox(height: 8),
                  ShaderMask(
                    shaderCallback: (bounds) => LinearGradient(
                      colors: [Color(0xFF36a4da), Color(0xFFe85021)],
                    ).createShader(bounds),
                    child: Text(
                      'Elimu Library',
                      style: TextStyle(
                        fontSize: 32,
                        fontWeight: FontWeight.bold,
                        color: Colors.white,
                      ),
                    ),
                  ),
                  const SizedBox(height: 16),
                  Text(
                    'Select a grade category above\nto explore exciting books!',
                    textAlign: TextAlign.center,
                    style: TextStyle(
                      fontSize: 15,
                      color: Colors.black54,
                      height: 1.5,
                    ),
                  ),
                ],
              ),
            ),
                          ),
                          // Right decorative section
                          Expanded(
                            flex: 1,
                            child: Column(
                              children: [
                                Icon(Icons.emoji_objects, size: 60, color: Color(0xFFe85021).withOpacity(0.3)),
                                const SizedBox(height: 20),
                                Icon(Icons.star, size: 50, color: Color(0xFF36a4da).withOpacity(0.3)),
                                const SizedBox(height: 20),
                                Icon(Icons.celebration, size: 55, color: Color(0xFFe85021).withOpacity(0.3)),
                              ],
                            ),
                          ),
                        ],
                      ),
                    ),
                  // Search bar - only show if grade selected
                  if (_selectedGrade != null)
                    Padding(
                      padding: const EdgeInsets.fromLTRB(24, 16, 24, 16),
                      child: TextField(
                        onChanged: (value) {
                          setState(() {
                            _searchQuery = value;
                          });
                        },
                        decoration: InputDecoration(
                          hintText: 'Search by title or author...',
                          prefixIcon: const Icon(Icons.search),
                          enabledBorder: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(8),
                            borderSide: const BorderSide(color: Color(0xFFe85020), width: 1.5),
                          ),
                          focusedBorder: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(8),
                            borderSide: const BorderSide(color: Color(0xFFe85020), width: 2),
                          ),
                          border: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(8),
                            borderSide: const BorderSide(color: Color(0xFFe85020), width: 1.5),
                          ),
                        ),
                      ),
                    ),
                  // Books grid - only show if grade selected
                  if (_selectedGrade != null)
                    Padding(
                      padding: const EdgeInsets.all(24),
                      child: SizedBox(
                        width: 600,
                        height: 600,
                        child: FutureBuilder<List<Ebook>>(
                          future: _ebooksFuture,
                          builder: (context, snapshot) {
                            if (snapshot.connectionState == ConnectionState.waiting) {
                              return const Center(
                                child: CircularProgressIndicator(color: Color(0xFF36a4da)),
                              );
                            }

                            if (snapshot.hasError) {
                              return Center(
                                child: Text('Error: ${snapshot.error}'),
                              );
                            }

                            final ebooks = snapshot.data ?? [];
                            final filtered = _filterEbooks(ebooks);

                            if (filtered.isEmpty) {
                              return const Center(
                                child: Column(
                                  mainAxisAlignment: MainAxisAlignment.center,
                                  children: [
                                    Icon(Icons.library_books, size: 64, color: Colors.grey),
                                    SizedBox(height: 16),
                                    Text('No books available for this grade'),
                                  ],
                                ),
                              );
                            }

                            // Masonry grid layout - 4 columns for tablet
                            return GridView.builder(
                              padding: const EdgeInsets.all(0),
                              gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
                                crossAxisCount: MediaQuery.of(context).size.width > 600 ? 4 : 2,
                                childAspectRatio: 0.7,
                                crossAxisSpacing: 12,
                                mainAxisSpacing: 12,
                              ),
                              itemCount: filtered.length,
                              itemBuilder: (context, index) {
                                final ebook = filtered[index];
                                return _buildBookCard(context, ebook);
                              },
                            );
                          },
                        ),
                      ),
                    ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildBookCard(BuildContext context, Ebook ebook) {
    final ThumbnailService thumbnailService = ThumbnailService();
    
    return GestureDetector(
      onTap: () {
        if (ebook.localPath != null && ebook.localPath!.isNotEmpty) {
          Navigator.push(
            context,
            MaterialPageRoute(
              builder: (context) => ReaderScreen(ebook: ebook),
            ),
          );
        } else {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(content: Text('Ebook file not available')),
          );
        }
      },
      child: Container(
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(12),
          border: Border.all(color: const Color(0xFFe85020), width: 2),
          boxShadow: [
            BoxShadow(
              color: Colors.black.withOpacity(0.1),
              blurRadius: 8,
              offset: const Offset(0, 4),
            ),
          ],
        ),
        child: Card(
          margin: EdgeInsets.zero,
          elevation: 0,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(10),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              // Thumbnail - with gradient background if no thumbnail
              Expanded(
                flex: 2,
                child: ClipRRect(
                  borderRadius: const BorderRadius.only(
                    topLeft: Radius.circular(10),
                    topRight: Radius.circular(10),
                  ),
                  child: FutureBuilder<Uint8List?>(
                    future: thumbnailService.getThumbnail(ebook.localPath ?? ''),
                    builder: (context, snapshot) {
                      if (snapshot.hasData && snapshot.data != null) {
                        return Image.memory(
                          snapshot.data!,
                          fit: BoxFit.cover,
                        );
                      }
                      // Fallback: gradient background with book icon
                      return Container(
                        decoration: BoxDecoration(
                          gradient: LinearGradient(
                            begin: Alignment.topLeft,
                            end: Alignment.bottomRight,
                            colors: [
                              const Color(0xFF36a4da).withOpacity(0.8),
                              const Color(0xFFe85020).withOpacity(0.6),
                            ],
                          ),
                        ),
                        child: const Center(
                          child: Icon(
                            Icons.library_books,
                            size: 50,
                            color: Colors.white,
                          ),
                        ),
                      );
                    },
                  ),
                ),
              ),
              // Book info section
              Expanded(
                flex: 2,
                child: Padding(
                  padding: const EdgeInsets.all(8),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      // Title
                      Text(
                        ebook.title,
                        maxLines: 2,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(
                          fontWeight: FontWeight.bold,
                          fontSize: 12,
                        ),
                      ),
                      const SizedBox(height: 4),
                      // Author
                      Text(
                        ebook.author,
                        maxLines: 1,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(
                          fontSize: 10,
                          color: Colors.grey,
                        ),
                      ),
                      const Spacer(),
                      // Pages badge
                      Row(
                        children: [
                          const Icon(Icons.description, size: 12, color: Color(0xFF36a4da)),
                          const SizedBox(width: 4),
                          Text(
                            '${ebook.totalPages} pages',
                            style: const TextStyle(
                              fontSize: 10,
                              fontWeight: FontWeight.w500,
                              color: Color(0xFF36a4da),
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
